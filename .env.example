# Copie estas opções para o arquivo .env e preencha somente as chaves dos serviços usados.
# O Nino inicia no modo local; APIs online só são usadas nos modos online/automático.
GEMINI_API_KEY=
NINO_GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
OPENJARVIS_URL=http://localhost:8000/v1
NINO_LOCAL_CHAT_URL=http://localhost:11434/v1
# Opcional: informe o nome exato de um modelo listado pelo servidor local.
NINO_LOCAL_CHAT_MODEL=
